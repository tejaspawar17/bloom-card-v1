# Client-Side Variables (Bundled into frontend - NEVER put private secrets here)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-public-anon-key

# Server-Side Variables (Configured exclusively in Vercel Project Settings)
# RESEND_API_KEY=re_your_secret_resend_api_key
# NOTIFICATION_EMAIL=your-inbox@example.com
